# OffDiff Environment Variables
# AI provider credentials (Optional - OffDiff works 100% deterministically without keys)
GEMINI_API_KEY=your_gemini_or_gemma_api_key_here

# Optional: Model identifier (Supported: gemini-2.5-flash, gemini-1.5-flash, gemma-2-9b-it)
OFFDIFF_AI_MODEL=gemini-2.5-flash

# Optional: Graphify executable path override (defaults to 'python -m graphify' or 'graphify')
GRAPHIFY_CMD=python -m graphify
