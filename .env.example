# ==============================================================================
# OffDiff Environment Configuration Template
# ==============================================================================
# NOTE: OffDiff operates 100% DETERMINISTICALLY by default without any API keys.
# AI semantic investigation is optional and only triggered when --ai or the dashboard
# checkbox is explicitly toggled.
#
# To use:
#   1. Copy this file to .env.local:
#        cp .env.example .env.local
#   2. Insert your Google GenAI / Gemini API key below.
#   3. Never commit .env.local to source control.
# ==============================================================================

# [Optional] Google GenAI API Key for semantic claim investigations
# Obtain a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_or_gemma_api_key_here

# [Optional] AI Model Identifier
# Supported models:
#   - gemma-4-26b-a4b-it (Recommended for nuanced semantic refactoring claims)
#   - gemini-2.5-flash
#   - gemini-1.5-flash
OFFDIFF_AI_MODEL=gemma-4-26b-a4b-it

# [Optional] Custom command or path to Graphify CLI
# Default: 'python -m graphify'
GRAPHIFY_CMD=python -m graphify
